  m_Name: MissionScript
  m_EditorClassIdentifier: Assembly-CSharp::_Project.Mission.MissionScript
  speakerName: "\u0414\u0438\u0441\u043F\u0435\u0442\u0447\u0435\u0440\u043A\u0430
    \u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D\u0430"
  callSign: "\u0411\u0410\u0417\u0410"
  introDelay: 1.2
  stagePause: 5
  outroDelay: 4.5
  arrivalDistance: 45
  messyBill: 15000
  intro:
  - "\u041D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439? \u0422\u0430\u043A,
    \u0431\u0430\u0447\u0443. \u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E
    \u0434\u043E \u043F\u043E\u0436\u0435\u0436\u043D\u043E\u0457 \u0447\u0430\u0441\u0442\u0438\u043D\u0438."
  - "\u041E\u0442\u0436\u0435, \u0442\u0432\u043E\u0454 \u0442\u0435\u0441\u0442\u043E\u0432\u0435
    \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F: \u0432 \u043C\u0456\u0441\u0442\u0456
    \u043A\u0456\u043B\u044C\u043A\u0430 \u043F\u043E\u0436\u0435\u0436. \u041F\u043E\u0433\u0430\u0441\u0438\u0448
    \u0443\u0441\u0456, \u0456 \u0432\u0432\u0430\u0436\u0430\u0439, \u0449\u043E
    \u0442\u0435\u0431\u0435 \u0432\u0437\u044F\u043B\u0438."
  - "\u041C\u0430\u0448\u0438\u043D\u0430 \u0442\u0432\u043E\u044F, \u0448\u043B\u0430\u043D\u0433
    \u043D\u0430 \u043D\u0456\u0439. \u041C\u0456\u043D\u0456\u043A\u0430\u0440\u0442\u0430
    \u0441\u043F\u0440\u0430\u0432\u0430 \u0432\u0433\u043E\u0440\u0456, \u043F\u043E\u0437\u043D\u0430\u0447\u043A\u0438
    \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456 \u043F\u0456\u0434\u043A\u0430\u0436\u0443\u0442\u044C,
    \u043A\u0443\u0434\u0438 \u0457\u0445\u0430\u0442\u0438."
  - "\u0406 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u043D\u0456\u043A\u043E\u0433\u043E
    \u043D\u0435 \u043F\u0435\u0440\u0435\u0457\u0445\u0430\u0442\u0438. \u0425\u043E\u0447\u0430
    \u0431 \u043D\u0430 \u043F\u0435\u0440\u0448\u043E\u043C\u0443 \u0432\u0438\u043A\u043B\u0438\u043A\u0443."
  firstCall: "\u041F\u0435\u0440\u0448\u0438\u0439 \u0432\u0438\u043A\u043B\u0438\u043A
    \u0437\u043E\u0432\u0441\u0456\u043C \u043F\u043E\u0440\u0443\u0447: {0}, \u043C\u0435\u0442\u0440\u0456\u0432
    {1}. \u0412\u043F\u0435\u0440\u0435\u0434!"
  nextCall: "\u041D\u043E\u0432\u0438\u0439 \u0432\u0438\u043A\u043B\u0438\u043A:
    {0}, \u043C\u0435\u0442\u0440\u0456\u0432 {1}. \u0416\u0435\u043D\u0438!"
  finalCall: "\u0414\u0432\u0430 \u0432\u0438\u043A\u043B\u0438\u043A\u0438 \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E!
    \u0426\u0435 \u0432\u0436\u0435 \u043D\u0435 \u0442\u0435\u0441\u0442\u043E\u0432\u0435,
    \u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0456\u0432\u0442\u043E\u0440\u043E\u043A.
    \u041D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0438\u0439 \u2014 {0}, \u043C\u0435\u0442\u0440\u0456\u0432
    {1}."
  arrived: "\u041F\u0440\u0438\u0457\u0445\u0430\u0432? \u0412\u0438\u0445\u043E\u0434\u044C
    \u0437 \u043C\u0430\u0448\u0438\u043D\u0438, E. \u0428\u043B\u0430\u043D\u0433
    \u043D\u0430 \u043A\u043E\u0442\u0443\u0448\u0446\u0456 \u0437\u0437\u0430\u0434\u0443,
    \u0442\u0435\u0436 E."
  hoseTaken: "\u041B\u041A\u041C: \u0432\u043E\u0434\u0430. \u0426\u0456\u043B\u044C\u0441\u044F
    \u0432 \u043E\u0441\u043D\u043E\u0432\u0443 \u0432\u043E\u0433\u043D\u044E, \u0430
    \u043D\u0435 \u0432 \u043D\u0435\u0431\u043E."
  lastFlames: "\u0429\u0435 \u0442\u0440\u043E\u0445\u0438! \u0414\u0438\u0432\u0438\u0441\u044C
    \u043D\u0430 \u043F\u043E\u0437\u043D\u0430\u0447\u043A\u0438, \u0442\u0430\u043C
    \u0449\u0435 \u0436\u0435\u0432\u0440\u0456\u0454."
  reignited: "\u0412\u043E\u043D\u043E \u0437\u043D\u043E\u0432\u0443 \u0433\u043E\u0440\u0438\u0442\u044C.
    \u0413\u0430\u0441\u0438 \u0434\u043E \u043A\u0456\u043D\u0446\u044F, \u0430
    \u043D\u0435 \u0434\u043E \xAB\u043C\u0430\u0439\u0436\u0435\xBB."
  pedestrianHit: "\u042F \u0446\u044C\u043E\u0433\u043E \u043D\u0435 \u0431\u0430\u0447\u0438\u043B\u0430.
    \u041E\u0444\u0456\u0446\u0456\u0439\u043D\u043E \u043D\u0435 \u0431\u0430\u0447\u0438\u043B\u0430."
  callSaved:
  - "\u0404! \u041E\u0434\u0438\u043D \u0454. \u041D\u0435 \u0440\u043E\u0437\u0441\u043B\u0430\u0431\u043B\u044F\u0439\u0441\u044F."
  - "\u0427\u0443\u0434\u043E\u0432\u043E. \u0422\u0440\u0438\u043C\u0430\u0439 \u0442\u0435\u043C\u043F,
    \u043C\u0456\u0441\u0442\u043E \u0449\u0435 \u0433\u043E\u0440\u0438\u0442\u044C."
  outroStart: "\u0423\u0441\u0435. \u041C\u0456\u0441\u0442\u043E \u0441\u0442\u043E\u0457\u0442\u044C.
    \u041D\u0443, \u043F\u0435\u0440\u0435\u0432\u0430\u0436\u043D\u043E \u0441\u0442\u043E\u0457\u0442\u044C."
  outroClean: "\u0416\u043E\u0434\u043D\u043E\u0457 \u043F\u043E\u0434\u0440\u044F\u043F\u0438\u043D\u0438?
    \u0422\u0438 \u0442\u043E\u0447\u043D\u043E \u0437 \u043D\u0430\u0448\u043E\u0457
    \u0447\u0430\u0441\u0442\u0438\u043D\u0438?"
  outroMessy: "\u0420\u0430\u0445\u0443\u043D\u043E\u043A \u0437\u0430 \u043B\u0456\u0445\u0442\u0430\u0440\u0456,
    \u043C\u0430\u0448\u0438\u043D\u0438 \u0439 \u043D\u0435\u0440\u0432\u0438 \u0433\u043E\u0440\u043E\u0434\u044F\u043D
    \u043F\u0440\u0438\u0439\u0434\u0435 \u043E\u043A\u0440\u0435\u043C\u043E."
  outroEnd: "\u0422\u0435\u0441\u0442\u043E\u0432\u0435 \u0437\u0430\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u043E.
    \u0417\u0430\u0432\u0442\u0440\u0430 \u043E \u0441\u044C\u043E\u043C\u0456\u0439,
    \u043D\u0435 \u0441\u043F\u0456\u0437\u043D\u044E\u0439\u0441\u044F."
  directions:
  - "\u043D\u0430 \u043F\u0456\u0432\u043D\u043E\u0447\u0456"
  - "\u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447\u043D\u043E\u043C\u0443 \u0441\u0445\u043E\u0434\u0456"
  - "\u043D\u0430 \u0441\u0445\u043E\u0434\u0456"
  - "\u043D\u0430 \u043F\u0456\u0432\u0434\u0435\u043D\u043D\u043E\u043C\u0443 \u0441\u0445\u043E\u0434\u0456"
  - "\u043D\u0430 \u043F\u0456\u0432\u0434\u043D\u0456"
  - "\u043D\u0430 \u043F\u0456\u0432\u0434\u0435\u043D\u043D\u043E\u043C\u0443 \u0437\u0430\u0445\u043E\u0434\u0456"
  - "\u043D\u0430 \u0437\u0430\u0445\u043E\u0434\u0456"
  - "\u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447\u043D\u043E\u043C\u0443 \u0437\u0430\u0445\u043E\u0434\u0456"
